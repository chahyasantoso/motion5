{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@motion5/core": ["packages/core/src/index.ts"],
      "@motion5/core/internal": ["packages/core/src/internal.ts"],
      "@motion5/react": ["packages/react/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts"]
}
