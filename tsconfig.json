{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@gerak/dom": ["packages/dom/src/index.ts"],
      "@gerak/moves": ["packages/moves/src/index.ts"],
      "@gerak/player": ["packages/player/src/index.ts"],
      "@gerak/physics": ["packages/physics/src/index.ts"],
      "@gerak/rapier": ["packages/rapier/src/index.ts"],
      "@gerak/tools/page": ["packages/tools/src/page/index.ts"],
      "@gerak/tools/scene": ["packages/tools/src/scene/index.ts"],
      "@gerak/tools/vite": ["packages/tools/src/vite/index.ts"],
      "@gerak/rig": ["packages/rig/src/index.ts"],
      "@gerak/stage": ["packages/stage/src/index.ts"],
      "@gerak/react": ["packages/react/src/index.ts"]
    },
    "jsx": "react-jsx"
  },
  "include": ["packages/**/*.ts", "test/repo/**/*.ts", "demo/**/*", "apps/**/*"]
}
