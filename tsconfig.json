{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@motion5/core": ["packages/core/src/index.ts"],
      "@motion5/core/internal": ["packages/core/src/internal.ts"],
      "@motion5/core/adapters": ["packages/core/src/adapters/index.ts"],
      "@motion5/core/testing": ["packages/core/src/testing/fakes.ts"],
      "@motion5/core/*": ["packages/core/src/*"],
      "@motion5/dom": ["packages/dom/src/index.ts"],
      "@motion5/dom/engine": ["packages/dom/src/engine/index.ts"],
      "@motion5/moves": ["packages/moves/src/index.ts"],
      "@motion5/player": ["packages/player/src/index.ts"],
      "@motion5/rig": ["packages/rig/src/index.ts"],
      "@motion5/rig/internal": ["packages/rig/src/internal.ts"],
      "@motion5/react": ["packages/react/src/index.ts"],
      "@motion5/plugins/fk": ["packages/plugins/src/fk/fk.ts"],
      "@motion5/plugins/fk3d": ["packages/plugins/src/fk/fk3d.ts"],
      "@motion5/plugins/ik": ["packages/plugins/src/ik/ik.ts"],
      "@motion5/plugins/ik3d": ["packages/plugins/src/ik/ik3d.ts"],
      "@motion5/plugins/labels": ["packages/plugins/src/host/labels.ts"],
      "@motion5/plugins/loader": ["packages/plugins/src/host/loader.ts"],
      "@motion5/plugins/models": ["packages/plugins/src/models/index.ts"],
      "@motion5/plugins/pose-classify": ["packages/plugins/src/pose/pose-classify.ts"],
      "@motion5/plugins/runner": ["packages/plugins/src/host/runner.ts"],
      "@motion5/plugins/transform": ["packages/plugins/src/transform/transform.ts"],
      "@motion5/plugins/transform3d": ["packages/plugins/src/transform/transform3d.ts"],
      "@motion5/plugins/*": ["packages/plugins/src/*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["packages/**/*.ts", "demo/**/*", "apps/**/*"]
}
