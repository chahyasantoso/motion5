{
  "name": "gerak",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Transactional dataflow animation runtime.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "scan:raw-templates": "node scripts/raw-template-scan.mjs",
    "scan:comments": "node scripts/comment-scan.mjs",
    "scan:cycles": "node scripts/cycle-scan.mjs",
    "scan:boundaries": "node scripts/boundary-scan.mjs",
    "adr-index": "node scripts/adr-index.mjs",
    "map": "node scripts/repo-map.mjs",
    "reference": "node scripts/reference.mjs",
    "adr-index:write": "node scripts/adr-index.mjs --write",
    "format": "prettier . --write --log-level warn",
    "format:check": "prettier . --check --log-level warn",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=default",
    "test:related": "vitest related --run",
    "metrics": "node scripts/repo-metrics.mjs",
    "test:boundaries": "node scripts/boundary-scan.mjs && vitest run test/repo/boundary-scan.test.ts",
    "test:comments": "node scripts/comment-scan.mjs && vitest run test/repo/comment-scan.test.ts",
    "benchmark": "node performance/graph-benchmark.mjs",
    "motion:sample": "node packages/tools/bin/motion-sample.mjs",
    "motion:frames": "node packages/tools/bin/motion-frames.mjs",
    "motion:compare": "node packages/tools/bin/motion-compare.mjs",
    "motion:new": "node packages/tools/bin/motion-new.mjs",
    "motion:moves": "node packages/tools/bin/motion-moves.mjs",
    "motion:promote": "node packages/tools/bin/motion-promote.mjs",
    "motion:check": "node packages/tools/bin/motion-check.mjs",
    "motion:points": "node packages/tools/bin/motion-points.mjs",
    "motion:probe": "node packages/tools/bin/motion-probe.mjs",
    "motion:read": "node packages/tools/bin/motion-read.mjs",
    "motion:render": "node packages/tools/bin/motion-render.mjs",
    "motion:review": "node packages/tools/bin/motion-review.mjs",
    "motion:timeline": "node packages/tools/bin/motion-timeline.mjs",
    "motion:live": "node packages/tools/bin/motion-live.mjs",
    "test:frames": "node packages/tools/bin/motion-frames-check.mjs",
    "test:watch": "vitest",
    "dev": "npm run dev --workspace=@gerak/pieces"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "^19.0.4",
    "@types/react-test-renderer": "19.1.0",
    "madge": "^8.0.0",
    "playwright-core": "1.65.0",
    "prettier": "3.6.2",
    "react": "19.2.8",
    "react-dom": "^19.2.8",
    "react-test-renderer": "19.2.8",
    "typescript": "5.8.3",
    "vitest": "^4.1.10"
  }
}
