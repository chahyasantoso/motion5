{
  "name": "motion5",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Transactional dataflow animation runtime.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "scan:raw-templates": "node scripts/raw-template-scan.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:verbose": "vitest run --reporter=default",
    "test:related": "vitest related --run",
    "metrics": "node scripts/repo-metrics.mjs",
    "test:contract": "vitest run packages/core/test/contract",
    "test:ports": "vitest run packages/core/test/contract/ports.test.ts",
    "test:integration": "vitest run packages/core/test/integration packages/plugins/test/integration",
    "test:boundaries": "node scripts/boundary-scan.mjs && vitest run packages/core/test/unit/scripts/boundary-scan.test.ts",
    "test:read-budget": "node scripts/read-budget-scan.mjs && vitest run packages/core/test/unit/scripts/read-budget-scan.test.ts",
    "benchmark": "node performance/graph-benchmark.mjs",
    "bench:ik": "node scripts/bench-ik.mjs",
    "bench:values": "node scripts/bench-values.mjs",
    "bench:edit-cost": "node scripts/bench-edit-cost.mjs",
    "test:watch": "vitest",
    "dev": "npm run dev --workspace=@motion5/react-demo",
    "dev:ik": "npm run dev --workspace=@motion5/ik-playground"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "24.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "^19.0.4",
    "@types/react-test-renderer": "19.1.0",
    "gsap": "3.15.0",
    "prettier": "3.6.2",
    "react": "19.2.8",
    "react-dom": "^19.2.8",
    "react-test-renderer": "19.2.8",
    "typescript": "5.8.3",
    "vitest": "^4.1.10"
  }
}
