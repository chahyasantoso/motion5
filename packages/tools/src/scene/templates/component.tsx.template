import React from "react";
import { usePlayer, useTarget } from "@motion5/react";
import { clock, scene } from "./__NAME__-scene";

/** Binds each target to its element; all motion lives in `__NAME__-scene.ts`. Click replays. */
export const __COMPONENT__: React.FC = () => {
  const playing = usePlayer(scene, clock);
  const title = useTarget(playing?.player, "title");
  return (
    <div className="stage" onClick={() => playing?.driver.replay()}>
      <div ref={title} className="title">
        __NAME__
      </div>
    </div>
  );
};
