import React, { useEffect, useRef } from "react";
import {
  AmbientLight,
  BoxGeometry,
  DirectionalLight,
  Mesh,
  MeshStandardMaterial,
  PerspectiveCamera,
  Scene,
  WebGLRenderer,
} from "three";
import { usePlayer } from "@gerak/react";
import { useTarget3d } from "@gerak/three/react";
import { clock, scene } from "./__NAME__-scene";

const WIDTH = 1280;
const HEIGHT = 720;

/** Builds the Three.js stage, binds each target to its mesh, and renders every frame; click replays.
 * `onReady` runs once the first frame has drawn. */
export const __COMPONENT__: React.FC<{ readonly onReady?: () => void }> = ({ onReady }) => {
  const playing = usePlayer(scene, clock);
  const box = useTarget3d(playing?.player, "box");
  const host = useRef<HTMLDivElement>(null);
  useEffect(() => {
    const parent = host.current;
    if (parent === null) return undefined;
    const renderer = new WebGLRenderer({ preserveDrawingBuffer: true });
    renderer.setSize(WIDTH, HEIGHT);
    parent.appendChild(renderer.domElement);
    const stage = new Scene();
    const camera = new PerspectiveCamera(50, WIDTH / HEIGHT, 0.1, 100);
    camera.position.set(0, 0, 10);
    const light = new DirectionalLight(0xffffff, 2);
    light.position.set(3, 5, 6);
    const geometry = new BoxGeometry(2, 2, 2);
    const material = new MeshStandardMaterial();
    const mesh = new Mesh(geometry, material);
    stage.add(new AmbientLight(0xffffff, 0.5), light, mesh);
    box(mesh);
    renderer.render(stage, camera);
    onReady?.();
    let frame = requestAnimationFrame(function draw() {
      renderer.render(stage, camera);
      frame = requestAnimationFrame(draw);
    });
    return () => {
      cancelAnimationFrame(frame);
      box(null);
      geometry.dispose();
      material.dispose();
      renderer.dispose();
      renderer.domElement.remove();
    };
  }, [box, onReady]);
  return <div ref={host} className="stage" onClick={() => playing?.driver.replay()} />;
};
