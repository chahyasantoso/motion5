import React, { useEffect, useRef } from "react";
import {
  AmbientLight,
  BoxGeometry,
  DirectionalLight,
  Mesh,
  MeshStandardMaterial,
  PerspectiveCamera,
  Scene,
  WebGLRenderer,
} from "three";
import type { Events, Time } from "@gerak/core";
import { applyValue } from "@gerak/dom";
import { usePlayer, useTarget } from "@gerak/react";
import { compileScene, formatStageError, frame, poseOf } from "@gerak/stage";
import { applyPose3d, threeBinder } from "@gerak/three";
import piece, { clock, lens, size } from "./__NAME__-scene";

const compiled = compileScene(piece);
if (!compiled.ok) throw new Error(compiled.errors.map(formatStageError).join("\n"));
const stage = compiled.stage;
const signal = (time: Time, events: Events) => frame(stage, { time, events }).targets;

/** Builds the Three.js stage, binds the scene's object, and draws on the player's step; click replays.
 * `onReady` runs once the first frame has drawn. */
export const __COMPONENT__: React.FC<{ readonly onReady?: () => void }> = ({ onReady }) => {
  const playing = usePlayer(signal, clock);
  const player = playing?.player;
  const label = useTarget(player, "label", (element, value) => {
    const pose = poseOf(value);
    if (pose !== undefined) applyValue(element, pose);
  });
  const host = useRef<HTMLDivElement>(null);
  useEffect(() => {
    const parent = host.current;
    if (player === undefined || parent === null) return undefined;
    const renderer = new WebGLRenderer({ preserveDrawingBuffer: true });
    renderer.setSize(size.width, size.height);
    parent.insertBefore(renderer.domElement, parent.firstChild);
    const world = new Scene();
    const camera = new PerspectiveCamera(lens.fov, size.width / size.height, 0.1, 100);
    applyPose3d(camera, lens);
    const light = new DirectionalLight(0xffffff, 2);
    light.position.set(3, 5, 6);
    const geometry = new BoxGeometry(2, 2, 2);
    const material = new MeshStandardMaterial();
    const mesh = new Mesh(geometry, material);
    world.add(new AmbientLight(0xffffff, 0.5), light, mesh);
    mesh.name = "box";
    const draw = () => renderer.render(world, camera);
    const unbind = threeBinder(world, { draw }).start(player, stage);
    onReady?.();
    return () => {
      unbind();
      geometry.dispose();
      material.dispose();
      renderer.dispose();
      renderer.domElement.remove();
    };
  }, [player, onReady]);
  return (
    <div
      ref={host}
      className="stage"
      style={{ width: size.width, height: size.height }}
      onClick={() => playing?.driver.replay()}
    >
      <div ref={label} className="label">
        box
      </div>
    </div>
  );
};
