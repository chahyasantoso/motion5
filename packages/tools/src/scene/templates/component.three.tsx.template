import React, { useCallback, useEffect, useRef } from "react";
import {
  AmbientLight,
  BoxGeometry,
  DirectionalLight,
  Mesh,
  MeshStandardMaterial,
  PerspectiveCamera,
  Scene,
  WebGLRenderer,
} from "three";
import { usePlayer, useTarget } from "@gerak/react";
import { applyPose3d } from "@gerak/three";
import { useTarget3d } from "@gerak/three/react";
import { clock, lens, scene, stage } from "./__NAME__-scene";

/** Builds the Three.js stage, binds each target, and draws when a target is written; click replays.
 * `onReady` runs once the first frame has drawn. */
export const __COMPONENT__: React.FC<{ readonly onReady?: () => void }> = ({ onReady }) => {
  const playing = usePlayer(scene, clock);
  const draw = useRef<() => void>(() => undefined);
  const invalidate = useCallback(() => draw.current(), []);
  const box = useTarget3d(playing?.player, "box", { invalidate });
  const label = useTarget(playing?.player, "label");
  const host = useRef<HTMLDivElement>(null);
  useEffect(() => {
    const parent = host.current;
    if (parent === null) return undefined;
    const renderer = new WebGLRenderer({ preserveDrawingBuffer: true });
    renderer.setSize(stage.width, stage.height);
    parent.appendChild(renderer.domElement);
    const world = new Scene();
    const camera = new PerspectiveCamera(lens.fov, stage.width / stage.height, 0.1, 100);
    applyPose3d(camera, lens);
    const light = new DirectionalLight(0xffffff, 2);
    light.position.set(3, 5, 6);
    const geometry = new BoxGeometry(2, 2, 2);
    const material = new MeshStandardMaterial();
    const mesh = new Mesh(geometry, material);
    world.add(new AmbientLight(0xffffff, 0.5), light, mesh);
    box(mesh);
    draw.current = () => renderer.render(world, camera);
    draw.current();
    onReady?.();
    return () => {
      draw.current = () => undefined;
      box(null);
      geometry.dispose();
      material.dispose();
      renderer.dispose();
      renderer.domElement.remove();
    };
  }, [box, onReady]);
  return (
    <div
      ref={host}
      className="stage"
      style={{ width: stage.width, height: stage.height }}
      onClick={() => playing?.driver.replay()}
    >
      <div ref={label} className="label">
        box
      </div>
    </div>
  );
};
