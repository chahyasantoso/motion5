+  it("D-9 keeps the construction failure in front when the composition release throws", () => {
+    // Issue #469. `ProjectRuntime`'s constructor released the composition and then rethrew whatever
+    // came back, so a `GraphRuntime` refusal was replaced by the host's release failure and the
+    // reason the load was refused was gone. It reaches the one owner of that precedence now.
+    // `D-6`'s project is the fixture because it is the one refusal that lands while a compiled
+    // Track is all there is to release, and a Track's release reaches exactly one injected thing.
+    // Red on `main`, where the thrown value is the release failure alone; `D-6` keeps asserting the
+    // unwrapped `TypeError`, which is what proves the aggregation is conditional. ADR-035's
+    // precedence, applied one layer above the call sites that record named.
+    const clock = countingClock();
+    const triggers = triggerProbe();
+    const interpolators = interpolatorProbe();
