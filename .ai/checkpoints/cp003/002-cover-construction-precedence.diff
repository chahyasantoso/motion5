+interface InterpolatorProbe {
+  readonly interpolator: Interpolator;
+  /** The exact instance a hostile Track release throws, so a case asserts identity. */
+  readonly killFailure: Error;
+}
+
+/**
+ * Wraps the shipped fake so a compiled Track is ordinary in everything but its release.
+ *
+ * `Track.dispose()` reaches exactly one injected thing, `#timeline.kill()`, so the timeline is
+ * the only seam a hostile Track release has. `kill` is replaced on the instance the fake built
+ * rather than copied onto a second object, for the reason `triggerProbe` names every field it
+ * forwards: a spread over an interface silently drops whatever the implementation put behind it.
+ */
+function interpolatorProbe(): InterpolatorProbe {
+  const base = createFakeInterpolator();
+  const killFailure = new Error("host timeline teardown failed");
+  const interpolator: Interpolator = {
+    create(config) {
+      return Object.assign(base.create(config), {
+        kill() {
+          throw killFailure;
+        },
+      });
+    },
+  };
+  return { interpolator, killFailure };
+}
