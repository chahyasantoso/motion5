+          observerId: "walker/arm-solve",
+          sourceId: "walker/shoulder",
+          role: "input",
+        } as unknown as GraphEdge,
+      ],
+      readyCompose({ rotations: {} }),
+      { solves: Object.freeze([{ id: "walker/upper-arm", base: "walker/shoulder" }]) },
