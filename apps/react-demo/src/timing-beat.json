{
  "schemaVersion": 5,
  "projectId": "timing-beat",
  "motions": [
    {
      "id": "letters",
      "trigger": {
        "type": "time",
        "duration": 1000
      },
      "tracks": [
        {
          "id": "word",
          "output": {
            "plugin": "cascade"
          },
          "input": {
            "param": {
              "move": "drop",
              "count": 6,
              "stagger": 0.25,
              "distance": 700,
              "squash": 0.18
            }
          }
        }
      ]
    },
    {
      "id": "period",
      "trigger": {
        "type": "time",
        "duration": 990,
        "delay": 880
      },
      "tracks": [
        {
          "id": "dot",
          "output": {
            "plugin": "hop"
          },
          "input": {
            "param": {
              "height": 260,
              "bounces": 2,
              "decay": 0.35,
              "squash": 0.45,
              "dx": 1300
            }
          }
        }
      ]
    },
    {
      "id": "cover",
      "trigger": {
        "type": "time",
        "duration": 600,
        "delay": 2400
      },
      "tracks": [
        {
          "id": "wipe",
          "output": {
            "plugin": "wipe"
          },
          "input": {
            "param": {
              "radius": 1500,
              "x": 0,
              "y": 0
            }
          }
        }
      ]
    }
  ]
}
